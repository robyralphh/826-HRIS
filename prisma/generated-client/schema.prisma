// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated-client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  email      String      @unique
  username   String?
  password   String
  roleId     String      @db.ObjectId
  role       Role        @relation(fields: [roleId], references: [id])
  branchId   String?     @db.ObjectId
  branch     Branch?     @relation(fields: [branchId], references: [id])
  actionLogs ActionLog[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Role {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?
  isManager   Boolean @default(false)

  parentRoleId String? @db.ObjectId
  parentRole   Role?   @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childRoles   Role[]  @relation("RoleHierarchy")

  gracePeriodMinutes Int @default(0)

  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roleId    String   @db.ObjectId
  role      Role     @relation(fields: [roleId], references: [id])
  module    String
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, module])
}

model Branch {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  name             String            @unique
  location         String?
  status           String            @default("active") // active, inactive
  users            User[]
  employees        Employee[]
  biometricDevices BiometricDevice[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Employee {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  firstName    String
  lastName     String
  email        String      @unique
  phone        String?
  dateOfBirth  DateTime?
  gender       String?
  address      String?
  // Relations to newly created models
  departmentId String?     @db.ObjectId
  department   Department? @relation(fields: [departmentId], references: [id])

  positionId String?   @db.ObjectId
  position   Position? @relation(fields: [positionId], references: [id])

  dateHired DateTime?
  status    String    @default("active") // active, inactive, resigned, etc.

  pictureUrl String? // ADDED picture upload Url

  educationalDegree      String?
  educationalInstitution String?
  yearGraduated          String?

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // Philippine Mandated Benefits Data
  sssNumber        String?
  sssStatus        String  @default("Pending") // Pending, Active, Exempt
  philHealthNumber String?
  philHealthStatus String  @default("Pending")
  pagIbigNumber    String?
  pagIbigStatus    String  @default("Pending")
  tinNumber        String? // Tax Identification Number

  salaryType String @default("Monthly") // "Monthly", "Hourly", "Daily"
  baseSalary Float  @default(0)
  /// DOLE annualization factor: 313 = Mon–Sat, 261 = Mon–Fri
  workFactor Int    @default(313)

  branchId String? @db.ObjectId
  branch   Branch? @relation(fields: [branchId], references: [id])

  masterSchedule    MasterSchedule? // Renamed from schedule
  scheduleOverrides ScheduleOverride[] // Renamed from shiftExceptions

  benefits EmployeeBenefit[]

  timeRequests   TimeRequest[] // Relations to Overtime and Undertime requests
  leaveRequests  LeaveRequest[] // Relations to Vacation and Sick Leaves
  attendances    Attendance[]
  payrollRecords PayrollRecord[]
  expenses       ExpenseRequest[]
  loans          CompanyLoan[]
  assets         CompanyAsset[]
  biometricId    String?
  employeeNo     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BenefitPlan {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  type        String // Health, Allowance, Insurance, etc.
  description String?

  enrollments EmployeeBenefit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeBenefit {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  benefitPlanId String      @db.ObjectId
  benefitPlan   BenefitPlan @relation(fields: [benefitPlanId], references: [id], onDelete: Cascade)

  status String @default("Active") // Active, Inactive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, benefitPlanId])
}

model Department {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?
  status      String  @default("active") // active, inactive

  positions Position[]
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  status      String  @default("active") // active, inactive

  departmentId String?     @db.ObjectId
  department   Department? @relation(fields: [departmentId], references: [id])

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, departmentId])
}

model Shift {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique // e.g., "Morning Shift", "Closing"
  startTime String // "08:00"
  endTime   String // "17:00"
  workDays  String[] // ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]

  isFlexi    Boolean @default(false)
  flexiHours Float? // Number of hours required to render

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mondayMasterSchedules    MasterSchedule[] @relation("MondayShift")
  tuesdayMasterSchedules   MasterSchedule[] @relation("TuesdayShift")
  wednesdayMasterSchedules MasterSchedule[] @relation("WednesdayShift")
  thursdayMasterSchedules  MasterSchedule[] @relation("ThursdayShift")
  fridayMasterSchedules    MasterSchedule[] @relation("FridayShift")
  saturdayMasterSchedules  MasterSchedule[] @relation("SaturdayShift")
  sundayMasterSchedules    MasterSchedule[] @relation("SundayShift")
}

model MasterSchedule {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @unique @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  mondayId String? @db.ObjectId
  monday   Shift?  @relation("MondayShift", fields: [mondayId], references: [id])

  tuesdayId String? @db.ObjectId
  tuesday   Shift?  @relation("TuesdayShift", fields: [tuesdayId], references: [id])

  wednesdayId String? @db.ObjectId
  wednesday   Shift?  @relation("WednesdayShift", fields: [wednesdayId], references: [id])

  thursdayId String? @db.ObjectId
  thursday   Shift?  @relation("ThursdayShift", fields: [thursdayId], references: [id])

  fridayId String? @db.ObjectId
  friday   Shift?  @relation("FridayShift", fields: [fridayId], references: [id])

  saturdayId String? @db.ObjectId
  saturday   Shift?  @relation("SaturdayShift", fields: [saturdayId], references: [id])

  sundayId String? @db.ObjectId
  sunday   Shift?  @relation("SundayShift", fields: [sundayId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeRequest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type      String // "Overtime", "Undertime"
  date      DateTime // The date the OT/UT occured
  startTime String // HH:mm format
  endTime   String // HH:mm format
  reason    String?
  status    String   @default("Pending") // "Pending", "Approved", "Rejected"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String // e.g., "CREATE", "UPDATE", "DELETE"
  description String // e.g., "Created user xyz"
  createdAt   DateTime @default(now())
}

model LeaveRequest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type      String // "Leave (PTO)", "Sick Leave"
  startDate DateTime // The first day of the leave
  endDate   DateTime // The last day of the leave
  reason    String?
  status    String   @default("Pending") // "Pending", "Approved", "Rejected"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date              DateTime // Calendar date of the record
  timeIn            DateTime?
  timeOut           DateTime?
  status            String    @default("Present") // "Present", "Late", "Half-day"
  incidentReportUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollSetting {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  name       String  @unique // e.g., "Night Differential"
  percentage Float   @default(10)
  startTime  String  @default("22:00") // 10:00 PM
  endTime    String  @default("06:00") // 06:00 AM
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollPeriod {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String // e.g., "March 1-15, 2026"
  startDate DateTime
  endDate   DateTime
  status    String   @default("Draft") // Draft, Processing, Completed

  records PayrollRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollRecord {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  payrollPeriodId String        @db.ObjectId
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])

  salaryType String // Monthly, Hourly, Daily
  baseRate   Float

  // Work Hours/Days
  totalHours     Float @default(0)
  ndHours        Float @default(0)
  otHours        Float @default(0)
  lateHours      Float @default(0)
  undertimeHours Float @default(0)
  absentDays     Float @default(0)
  leaveDays      Float @default(0)

  // Earnings & Basic Pay Calculation
  basePay            Float @default(0) // Basic Salary (Per Cut Off)
  absenceDeduction   Float @default(0)
  undertimeDeduction Float @default(0)
  lateDeduction      Float @default(0)
  leavePay           Float @default(0)
  adjustment         Float @default(0)
  totalBasicPay      Float @default(0) // Sum of above

  // Government Dues
  sssDeduction     Float @default(0)
  phicDeduction    Float @default(0)
  hdmfDeduction    Float @default(0)
  hdmf2Deduction   Float @default(0)
  subTotalGovtDues Float @default(0)

  // System Flags
  isPositiveCrediting Boolean @default(false)

  // Other Taxable Additions
  ndPay              Float @default(0)
  otPay              Float @default(0)
  holidayPay         Float @default(0)
  grossTaxableIncome Float @default(0)

  // Non-Govt Deductions
  taxDeduction       Float @default(0) // Withholding Tax
  hmoDeduction       Float @default(0)
  sssLoan            Float @default(0)
  hdmfLoan           Float @default(0)
  companyLoan        Float @default(0)
  otherDeduction     Float @default(0)
  subTotalDeductions Float @default(0)

  // Non-Taxable Additions
  diemAllowance     Float @default(0)
  allowance         Float @default(0)
  subTotalAdditions Float @default(0)

  grossPay Float @default(0)
  netPay   Float @default(0)

  // Rate Snapshot — values frozen at the time of this payroll run.
  // Changing global settings later will NOT alter historical records.
  regularOTRate      Float  @default(1.25)
  nightDiffRate      Float  @default(0.10)
  ndStartTime        String @default("22:00")
  ndEndTime          String @default("06:00")
  holidayRegularRate Float  @default(2.00)
  holidaySpecialRate Float  @default(1.30)
  /// DOLE work-factor snapshot frozen at the time of this payroll run
  workFactor         Int    @default(313)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollPeriodId, employeeId])
}

model ExpenseRequest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  amount      Float
  category    String // e.g., "Travel", "Office Supplies", "Meals"
  description String
  receiptUrls String[]
  status      String   @default("Pending") // Pending, Approved, Rejected, Paid
  date        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyLoan {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  principalAmount  Float
  remainingBalance Float
  monthlyDeduction Float
  status           String @default("Active") // Active, Paid, Defaulted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyAsset {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String?   @db.ObjectId
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  name          String
  type          String // e.g., "Laptop", "Phone", "Vehicle"
  serialNumber  String?   @unique
  purchaseDate  DateTime?
  purchasePrice Float?
  condition     String    @default("Good") // Good, Fair, Poor, Broken
  status        String    @default("Available") // Available, Assigned, Maintenance, Retired

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LedgerEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime @default(now())
  type        String // "INCOME", "EXPENSE"
  category    String // e.g., "Payroll", "Reimbursement", "Asset Purchase"
  amount      Float
  description String?
  referenceId String? // Optional ID to link to a payroll record or expense ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BiometricDevice {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  name      String // e.g., "Main Lobby G2"
  branchId  String            @db.ObjectId
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ip        String // IP address of the device
  port      Int               @default(4370)
  status    String            @default("Active") // Active, Offline, Maintenance
  lastSync  DateTime?
  rawLogs   RawBiometricLog[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model RawBiometricLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceUserId String
  timestamp    DateTime
  state        Int? // 0 = In, 1 = Out

  deviceId String          @db.ObjectId
  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  isProcessed Boolean @default(false)
  processNote String? // Any errors or warnings during processing

  createdAt DateTime @default(now())

  // Ensure idempotency for device syncs
  @@unique([deviceId, deviceUserId, timestamp])
}

model Holiday {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  date       DateTime @unique
  type       String // "Regular", "Special Non-working", "Special Working"
  multiplier Float    @default(2.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ScheduleOverride {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // The specific date (YYYY-MM-DD midnight)

  startTime String? // HH:mm
  endTime   String? // HH:mm
  isRestDay Boolean @default(false)
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
}
